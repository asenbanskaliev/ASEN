  "type": "module",
  "files": [
    "extensions/",
    "src/",
    "skills/",
    "registry/",
    "docs/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
