  "scenario": {
    "name": "registration",
    "classification": "INTENTIONAL",
    "reason": "Both real Pi runtimes load their mapped Todo extension and register user-facing Todo tools. The source exposes one sequential whole-list tool; ASEN exposes separate add/list/revisioned-update tools plus independent review and recovery controls. This is an intentional session-scoped authorization and lifecycle redesign, not API equivalence."
  },
  "limitations": [
    "This registration probe verifies actual Pi 0.87.1 and Pi 1.1.0 extension loading and tool schemas without invoking a model; tool behavior remains covered by paired core-state runs and ASEN runtime tests.",
    "The source and candidate use different Pi major/minor API generations, so registration success does not certify cross-version visual parity."
  ]
